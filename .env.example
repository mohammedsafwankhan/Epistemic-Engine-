# Epistemic Engine Environment Configuration Template
# Copy this file to .env or app-specific .env files for local development.

# Application Environment
NODE_ENV=development
PORT=3001

# AWS Configuration (Placeholder for later phases / AWS dev environment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Storage (S3)
S3_BUCKET=epistemic-engine-documents-dev

# Database (DynamoDB)
DYNAMODB_TABLE=epistemic-engine-dev

# AI Bedrock Integration Boundary
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

